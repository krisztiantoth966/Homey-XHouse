{
  "id": "com.tothk.xhouse",
  "version": "1.1.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "XHouse",
    "sk": "XHouse"
  },
  "description": {
    "en": "Make every arrival part of your smart home.",
    "sk": "Brána a garáž XHouse ako súčasť vašej smart domácnosti."
  },
  "category": "security",
  "tags": {
    "en": [
      "XHouse",
      "gate",
      "garage",
      "Giigle IoT"
    ]
  },
  "brandColor": "#0EA5E9",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Krisztián Tóth"
  },
  "capabilities": {
    "xhouse_gate_state": {
      "type": "enum",
      "title": {
        "en": "Gate state",
        "sk": "Stav brány"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "values": [
        {
          "id": "closed",
          "title": {
            "en": "Closed",
            "sk": "Zatvorená"
          }
        },
        {
          "id": "open",
          "title": {
            "en": "Open",
            "sk": "Otvorená"
          }
        },
        {
          "id": "opening",
          "title": {
            "en": "Opening",
            "sk": "Otvára sa"
          }
        },
        {
          "id": "closing",
          "title": {
            "en": "Closing",
            "sk": "Zatvára sa"
          }
        },
        {
          "id": "stopped",
          "title": {
            "en": "Stopped",
            "sk": "Zastavená"
          }
        },
        {
          "id": "unknown",
          "title": {
            "en": "Unknown",
            "sk": "Neznámy"
          }
        }
      ],
      "icon": "/assets/gate.svg"
    },
    "xhouse_position": {
      "type": "number",
      "title": {
        "en": "Gate position",
        "sk": "Poloha brány"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "decimals": 0,
      "units": "%",
      "step": 1,
      "icon": "/assets/position.svg"
    },
    "xhouse_left_position": {
      "type": "number",
      "title": {
        "en": "Left wing",
        "sk": "Ľavé krídlo"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "decimals": 0,
      "units": "%",
      "step": 1,
      "icon": "/assets/wing-left.svg"
    },
    "xhouse_right_position": {
      "type": "number",
      "title": {
        "en": "Right wing",
        "sk": "Pravé krídlo"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "decimals": 0,
      "units": "%",
      "step": 1,
      "icon": "/assets/wing-right.svg"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "gate_opened",
        "title": {
          "en": "The gate opened",
          "sk": "Brána sa otvorila"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ],
        "tokens": [
          {
            "name": "position",
            "type": "number",
            "title": {
              "en": "Position",
              "sk": "Poloha"
            }
          },
          {
            "name": "previous_state",
            "type": "string",
            "title": {
              "en": "Previous state",
              "sk": "Predchádzajúci stav"
            }
          }
        ]
      },
      {
        "id": "gate_closed",
        "title": {
          "en": "The gate closed",
          "sk": "Brána sa zatvorila"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ],
        "tokens": [
          {
            "name": "position",
            "type": "number",
            "title": {
              "en": "Position",
              "sk": "Poloha"
            }
          },
          {
            "name": "previous_state",
            "type": "string",
            "title": {
              "en": "Previous state",
              "sk": "Predchádzajúci stav"
            }
          }
        ]
      },
      {
        "id": "gate_opening",
        "title": {
          "en": "The gate started opening",
          "sk": "Brána sa začala otvárať"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ],
        "tokens": [
          {
            "name": "position",
            "type": "number",
            "title": {
              "en": "Position",
              "sk": "Poloha"
            }
          },
          {
            "name": "previous_state",
            "type": "string",
            "title": {
              "en": "Previous state",
              "sk": "Predchádzajúci stav"
            }
          }
        ]
      },
      {
        "id": "gate_closing",
        "title": {
          "en": "The gate started closing",
          "sk": "Brána sa začala zatvárať"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ],
        "tokens": [
          {
            "name": "position",
            "type": "number",
            "title": {
              "en": "Position",
              "sk": "Poloha"
            }
          },
          {
            "name": "previous_state",
            "type": "string",
            "title": {
              "en": "Previous state",
              "sk": "Predchádzajúci stav"
            }
          }
        ]
      },
      {
        "id": "gate_stopped",
        "title": {
          "en": "The gate stopped",
          "sk": "Brána sa zastavila"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ],
        "tokens": [
          {
            "name": "position",
            "type": "number",
            "title": {
              "en": "Position",
              "sk": "Poloha"
            }
          },
          {
            "name": "previous_state",
            "type": "string",
            "title": {
              "en": "Previous state",
              "sk": "Predchádzajúci stav"
            }
          }
        ]
      },
      {
        "id": "gate_online",
        "title": {
          "en": "The gate came online",
          "sk": "Brána je online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      },
      {
        "id": "gate_offline",
        "title": {
          "en": "The gate went offline",
          "sk": "Brána je offline"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "gate_is_state",
        "title": {
          "en": "The gate state is !{{|not}}",
          "sk": "Stav brány !{{je|nie je}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          },
          {
            "type": "dropdown",
            "name": "state",
            "title": {
              "en": "State",
              "sk": "Stav"
            },
            "values": [
              {
                "id": "closed",
                "title": {
                  "en": "Closed",
                  "sk": "Zatvorená"
                }
              },
              {
                "id": "open",
                "title": {
                  "en": "Open",
                  "sk": "Otvorená"
                }
              },
              {
                "id": "opening",
                "title": {
                  "en": "Opening",
                  "sk": "Otvára sa"
                }
              },
              {
                "id": "closing",
                "title": {
                  "en": "Closing",
                  "sk": "Zatvára sa"
                }
              },
              {
                "id": "stopped",
                "title": {
                  "en": "Stopped",
                  "sk": "Zastavená"
                }
              },
              {
                "id": "unknown",
                "title": {
                  "en": "Unknown",
                  "sk": "Neznámy"
                }
              }
            ]
          }
        ],
        "titleFormatted": {
          "en": "The gate state is [[state]]",
          "sk": "Stav brány je [[state]]"
        }
      },
      {
        "id": "gate_is_online",
        "title": {
          "en": "The gate is !{{online|offline}}",
          "sk": "Brána je !{{online|offline}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "open_gate",
        "title": {
          "en": "Open the gate",
          "sk": "Otvoriť bránu"
        },
        "highlight": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      },
      {
        "id": "close_gate",
        "title": {
          "en": "Close the gate",
          "sk": "Zatvoriť bránu"
        },
        "highlight": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      },
      {
        "id": "stop_gate",
        "title": {
          "en": "Stop the gate",
          "sk": "Zastaviť bránu"
        },
        "highlight": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      },
      {
        "id": "refresh_gate",
        "title": {
          "en": "Refresh gate status",
          "sk": "Obnoviť stav brány"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=gate"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "XHouse Gate (EGA/EGB)",
        "sk": "XHouse brána (EGA/EGB)"
      },
      "class": "garagedoor",
      "connectivity": [
        "cloud"
      ],
      "platforms": [
        "local"
      ],
      "settings": [
        {
          "id": "refresh_interval",
          "type": "number",
          "label": {
            "en": "Refresh interval (seconds)",
            "sk": "Interval obnovy (sekundy)"
          },
          "hint": {
            "en": "Normal polling interval. After a command and while the gate moves, the app checks every 1.5 seconds.",
            "sk": "Bežný interval obnovy stavu. Po príkaze a počas pohybu brány appka kontroluje stav každých 1,5 sekundy."
          },
          "value": 30,
          "attr": {
            "min": 5,
            "max": 300,
            "step": 5
          }
        },
        {
          "id": "debug_mode",
          "type": "checkbox",
          "label": {
            "en": "Debug logging",
            "sk": "Ladiace logovanie"
          },
          "hint": {
            "en": "Enable only while troubleshooting.",
            "sk": "Zapnite iba pri riešení problémov."
          },
          "value": false
        }
      ],
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "logo.svg",
            "usernameLabel": {
              "en": "XHouse email",
              "sk": "XHouse e-mail"
            },
            "usernamePlaceholder": {
              "en": "name@example.com",
              "sk": "meno@priklad.sk"
            },
            "passwordLabel": {
              "en": "XHouse password",
              "sk": "XHouse heslo"
            },
            "passwordPlaceholder": {
              "en": "Password",
              "sk": "Heslo"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "options": {
            "singular": false
          },
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "logo.svg",
            "usernameLabel": {
              "en": "XHouse email",
              "sk": "XHouse e-mail"
            },
            "usernamePlaceholder": {
              "en": "name@example.com",
              "sk": "meno@priklad.sk"
            },
            "passwordLabel": {
              "en": "XHouse password",
              "sk": "XHouse heslo"
            },
            "passwordPlaceholder": {
              "en": "Password",
              "sk": "Heslo"
            }
          }
        }
      ],
      "capabilities": [
        "garagedoor_closed",
        "windowcoverings_state",
        "xhouse_gate_state",
        "xhouse_position",
        "xhouse_left_position",
        "xhouse_right_position"
      ],
      "capabilitiesOptions": {
        "garagedoor_closed": {
          "title": {
            "en": "Gate closed",
            "sk": "Brána zatvorená"
          }
        },
        "windowcoverings_state": {
          "title": {
            "en": "Gate control",
            "sk": "Ovládanie brány"
          }
        }
      },
      "images": {
        "small": "/drivers/gate/assets/images/small.png",
        "large": "/drivers/gate/assets/images/large.png",
        "xlarge": "/drivers/gate/assets/images/xlarge.png"
      },
      "id": "gate"
    },
    {
      "name": {
        "en": "XHouse Garage Opener (XH-SGC01)",
        "sk": "XHouse garáž (XH-SGC01)"
      },
      "class": "garagedoor",
      "connectivity": [
        "cloud"
      ],
      "platforms": [
        "local"
      ],
      "settings": [
        {
          "id": "refresh_interval",
