          "label": {
            "en": "Refresh interval (seconds)",
            "sk": "Interval obnovy (sekundy)"
          },
          "hint": {
            "en": "Normal polling interval. After a command and while the gate moves, the app checks every 1.5 seconds.",
            "sk": "Bežný interval obnovy stavu. Po príkaze a počas pohybu brány appka kontroluje stav každých 1,5 sekundy."
          },
          "value": 30,
          "attr": {
            "min": 5,
            "max": 300,
            "step": 5
          }
        },
        {
          "id": "debug_mode",
          "type": "checkbox",
          "label": {
            "en": "Debug logging",
            "sk": "Ladiace logovanie"
          },
          "hint": {
            "en": "Enable only while troubleshooting.",
            "sk": "Zapnite iba pri riešení problémov."
          },
          "value": false
        }
      ],
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "logo.svg",
            "usernameLabel": {
              "en": "XHouse email",
              "sk": "XHouse e-mail"
            },
            "usernamePlaceholder": {
              "en": "name@example.com",
              "sk": "meno@priklad.sk"
            },
            "passwordLabel": {
              "en": "XHouse password",
              "sk": "XHouse heslo"
            },
            "passwordPlaceholder": {
              "en": "Password",
              "sk": "Heslo"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "options": {
            "singular": false
          },
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "logo.svg",
            "usernameLabel": {
              "en": "XHouse email",
              "sk": "XHouse e-mail"
            },
            "usernamePlaceholder": {
              "en": "name@example.com",
              "sk": "meno@priklad.sk"
            },
            "passwordLabel": {
              "en": "XHouse password",
              "sk": "XHouse heslo"
            },
            "passwordPlaceholder": {
              "en": "Password",
              "sk": "Heslo"
            }
          }
        }
      ],
      "capabilities": [
        "garagedoor_closed",
        "xhouse_gate_state",
        "xhouse_position"
      ],
      "capabilitiesOptions": {
        "garagedoor_closed": {
          "title": {
            "en": "Garage door closed",
            "sk": "Garáž zatvorená"
          }
        }
      },
      "images": {
        "small": "/drivers/garage/assets/images/small.png",
        "large": "/drivers/garage/assets/images/large.png",
        "xlarge": "/drivers/garage/assets/images/xlarge.png"
      },
      "id": "garage"
    }
  ],
  "contributors": {
    "developers": [
      {
        "name": "Ben Anderson",
